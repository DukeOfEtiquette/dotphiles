#!/usr/bin/env bash
#
# gpuHealth - quick GPU health report for the rogue workstation
#             (AMD Radeon RX 460/560 "Baffin", amdgpu driver).
#
# Reads temp/fan/power/clocks from lm-sensors (amdgpu) and usage/VRAM from sysfs.
# Prints color-coded OK/WARN/CRIT verdicts and exits 0 (all OK), 1 (any WARN),
# or 2 (any CRIT).
#
# Usage:
#   gpuHealth            one-shot snapshot
#   gpuHealth --watch    live refresh every 2s (Ctrl-C to exit)
#   gpuHealth --watch 5  live refresh every 5s
#
set -uo pipefail

# ---- common: colors + verdict helper -------------------------------------
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_CRIT=$'\033[31m'
    C_DIM=$'\033[2m'; C_HDR=$'\033[1;36m'; C_RST=$'\033[0m'
else
    C_OK=''; C_WARN=''; C_CRIT=''; C_DIM=''; C_HDR=''; C_RST=''
fi

worst=0   # 0=OK 1=WARN 2=CRIT, tracked across the snapshot
V=""      # set by verdict() to the colored status string for the last check

# verdict <value> <warn> <crit> -> sets global $V to a colored STATUS and bumps
# $worst. Must be called as a plain command (NOT in $(...)), else the $worst
# update happens in a subshell and is lost. Comparison uses awk so floats work.
verdict() {
    local val="$1" warn="$2" crit="$3"
    if [[ "$val" == "n/a" || -z "$val" ]]; then
        V="${C_DIM}n/a${C_RST}"; return
    fi
    local level
    level=$(awk -v v="$val" -v w="$warn" -v c="$crit" 'BEGIN{
        if (v+0 >= c+0) print 2; else if (v+0 >= w+0) print 1; else print 0 }')
    case "$level" in
        2) (( worst < 2 )) && worst=2; V="${C_CRIT}CRIT${C_RST}" ;;
        1) (( worst < 1 )) && worst=1; V="${C_WARN}WARN${C_RST}" ;;
        *) V="${C_OK}OK${C_RST}" ;;
    esac
}

# bump <level> -> raise $worst to at least <level> (for hand-rolled checks).
bump() { (( worst < $1 )) && worst=$1; return 0; }

# sensor_val <chip-glob> <key> -> the *_input value for a sensors -u key, or "".
sensor_val() {
    sensors -u "$1" 2>/dev/null | awk -v key="$2" '
        $0 ~ "^"key":" { found=1; next }
        found && /_input:/ { print $2; exit }
        found && /^[^ ]/   { found=0 }'
}

# sensor_sub <chip-glob> <key> <suffix> -> a non-_input sub-reading (e.g. _cap, _crit).
sensor_sub() {
    sensors -u "$1" 2>/dev/null | awk -v key="$2" -v suf="$3" '
        $0 ~ "^"key":" { found=1; next }
        found && $1 ~ suf":$" { print $2; exit }
        found && /^[^ ]/      { found=0 }'
}

GPU_DEV=$(ls -d /sys/class/drm/card*/device 2>/dev/null | head -1)

# sysfs_val <file> -> contents of a GPU sysfs file, or "n/a".
sysfs_val() {
    local f="$GPU_DEV/$1"
    if [[ -r "$f" ]]; then printf '%s' "$(< "$f")"; else echo "n/a"; fi
}

# ---- report ---------------------------------------------------------------
report() {
    worst=0
    local edge crit_t fan power cap sclk mclk busy mbusy vused vtotal dpm
    edge=$(sensor_val 'amdgpu-*' 'edge')
    crit_t=$(sensor_sub 'amdgpu-*' 'edge' '_crit')
    fan=$(sensor_val 'amdgpu-*' 'fan1')
    power=$(sensor_val 'amdgpu-*' 'PPT')
    cap=$(sensor_sub 'amdgpu-*' 'PPT' '_cap')
    # sclk/mclk report freqN_input in Hz; convert to MHz for display.
    sclk=$(sensor_val 'amdgpu-*' 'sclk'); sclk=$(awk -v v="$sclk" 'BEGIN{if(v=="")print"n/a";else printf "%d", v/1000000}')
    mclk=$(sensor_val 'amdgpu-*' 'mclk'); mclk=$(awk -v v="$mclk" 'BEGIN{if(v=="")print"n/a";else printf "%d", v/1000000}')
    busy=$(sysfs_val gpu_busy_percent)
    mbusy=$(sysfs_val mem_busy_percent)
    vused=$(sysfs_val mem_info_vram_used)
    vtotal=$(sysfs_val mem_info_vram_total)
    dpm=$(sysfs_val power_dpm_state)

    printf '%sGPU%s  AMD Radeon RX 460/560 (amdgpu)\n' "$C_HDR" "$C_RST"

    # edge temp: WARN 80, CRIT 90 (hw crit ~94)
    local crit_disp; crit_disp=$(awk -v v="${crit_t:-}" 'BEGIN{if(v=="")print"?";else printf "%.0f", v}')
    verdict "$edge" 80 90
    printf '  %-14s %7s °C   [%s]  %scrit %s°C%s\n' \
        "edge temp" "${edge:-n/a}" "$V" "$C_DIM" "$crit_disp" "$C_RST"

    # fan: WARN if 0 RPM while warm (>70C) -> possible fan fault
    if [[ -n "$fan" ]]; then
        local fan_status
        if awk -v f="$fan" -v t="${edge:-0}" 'BEGIN{exit !(f+0==0 && t+0>70)}'; then
            bump 1; fan_status="${C_WARN}WARN${C_RST}"
        else
            fan_status="${C_OK}OK${C_RST}"
        fi
        printf '  %-14s %6.0f RPM   [%s]\n' "fan" "$fan" "$fan_status"
    else
        printf '  %-14s %7s\n' "fan" "n/a"
    fi

    # power vs cap: warn 90%, crit 100% of cap
    if [[ -n "$power" && -n "$cap" ]]; then
        local pw pc
        pw=$(awk -v c="$cap" 'BEGIN{printf "%.2f", c*0.9}')
        pc=$(awk -v c="$cap" 'BEGIN{printf "%.2f", c}')
        verdict "$power" "$pw" "$pc"
        printf '  %-14s %6s W    [%s]  %scap %.0f W%s\n' \
            "power (PPT)" "$power" "$V" "$C_DIM" "$cap" "$C_RST"
    else
        printf '  %-14s %6s W\n' "power (PPT)" "${power:-n/a}"
    fi

    # VRAM used %: warn 80, crit 95
    if [[ "$vused" != "n/a" && "$vtotal" != "n/a" && "${vtotal:-0}" -gt 0 ]]; then
        local vpct vmib vtmib
        vpct=$(awk -v u="$vused" -v t="$vtotal" 'BEGIN{printf "%.1f", 100*u/t}')
        vmib=$(awk -v u="$vused" 'BEGIN{printf "%d", u/1048576}')
        vtmib=$(awk -v t="$vtotal" 'BEGIN{printf "%d", t/1048576}')
        verdict "$vpct" 80 95
        printf '  %-14s %6s%%     [%s]  %s%s / %s MiB%s\n' \
            "VRAM" "$vpct" "$V" "$C_DIM" "$vmib" "$vtmib" "$C_RST"
    else
        printf '  %-14s %7s\n' "VRAM" "n/a"
    fi

    printf '  %-14s %6s%%     %sgpu busy%s\n' "usage" "$busy" "$C_DIM" "$C_RST"
    printf '  %-14s %6s%%     %smem busy%s\n' "mem load" "$mbusy" "$C_DIM" "$C_RST"
    printf '  %-14s %5s/%s MHz %sengine/mem clock%s\n' "clocks" "${sclk:-n/a}" "${mclk:-n/a}" "$C_DIM" "$C_RST"
    printf '  %-14s %7s     %spower profile%s\n' "dpm state" "$dpm" "$C_DIM" "$C_RST"
}

# ---- main / watch ---------------------------------------------------------
case "${1:-}" in
    --watch|-w)
        interval="${2:-2}"
        trap 'printf "\033[?25h"; exit 0' INT TERM
        printf '\033[?25l'
        while true; do
            printf '\033[H\033[2J'
            printf '%sgpuHealth --watch (every %ss, Ctrl-C to quit)%s\n\n' "$C_DIM" "$interval" "$C_RST"
            report
            sleep "$interval"
        done
        ;;
    -h|--help)
        awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"
        ;;
    *)
        report
        exit "$worst"
        ;;
esac
